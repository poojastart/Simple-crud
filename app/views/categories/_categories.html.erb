<% if @categories.empty? %>
  <%= render 'empty_state' %>
<% else %>
  <table class="table table-striped table-borderless">
    <thead class="table-light">
      <tr>
        <th>id</th>
        <th>Name</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="categories">
      <%= render @categories %>
    </tbody>
  </table> 
<% end %>