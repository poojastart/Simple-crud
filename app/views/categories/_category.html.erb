<tr id="category_<%= category.id %>">
  <td class="fw-light"><%= category.id %></td>
  <td class="fw-light"><%= category.name %></td>
  <td class="fw-light"><%= category.description %></td>
  <td class="fw-light">
    <div >
      <%= link_to category_path(category), class: "btn btn-sm btn-outline-info", title: "View" do %>
        <i class="bi bi-eye"></i>
      <% end %>
      <%= link_to edit_category_path(category), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
        <i class="bi bi-pencil"></i>
      <% end %>
      <%= link_to category_path(category),
            data: {
              turbo_confirm: "Are you sure you want to delete this category?",
              turbo_method: :delete
            },
            class: "btn btn-sm btn-outline-danger", 
            title: "Delete" do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
  </td>
</tr>