<%= form_with(model: category, local: true, html: { multipart: true }) do |form| %>
  <% if category.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>
      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :image, class: "form-label" %>
    <%= form.file_field :image, accept: 'image/*', class: "form-control" %>
  </div>
  <div class="text-end">
    <%= form.submit category.new_record? ? "Create Category" : "Update Category", class: "btn btn-primary" %>
    <%= link_to "Back to List", categories_path, class: "btn btn-outline-secondary ms-2", data: { turbo_frame: "_top" } %>
  </div>
<% end %> 