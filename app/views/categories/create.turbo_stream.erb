<%= turbo_stream.append "categories", partial: "categories/category", locals: { category: @category } %>
<%= turbo_stream.replace "flash" do %>
  <%= render 'layouts/flash' %>
<% end %>
<%= turbo_stream.replace "new_category" do %>
  <%= render partial: "categories/show_category", locals: { category: @category } %>
<% end %>