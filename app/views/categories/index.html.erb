<div class="container-scroller">
  <%= render "layouts/navbar" %>
  <div class="container-fluid page-body-wrapper">
    <nav class="sidebar sidebar-offcanvas" id="sidebar">
      <ul class="nav">
        <li class="nav-item">
          <%= link_to root_path, class: "nav-link" do %>
            <i class="ti-dashboard menu-icon"></i>
            <span class="menu-title">Dashboard</span>
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to categories_path, class: "nav-link active" do %><i class="ti-layers-alt menu-icon"></i>
            <span class="menu-title">Categories</span>
          <% end %>
        </li>
      </ul>
    </nav>
    <div class="main-panel">
      <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
          <div class="card">
            <div class="card-body">
              <h4 class="card-title mb-4 fw-bold">Categories</h4>
              <div class="mt-3">
                <%= link_to "New Category", new_category_path, class: "btn btn-outline-primary", data: { turbo_frame: "_top" } %>
              </div>
              <div class="table-responsive">
                <%= render partial: "categories/categories", locals: { categories: @categories } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>