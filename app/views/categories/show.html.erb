<div class="category-details-wrapper container mt-5">
  <h1 class="mb-4 text-center">Category Details</h1>
  <%= turbo_frame_tag @category do %>
    <div class="card shadow-sm rounded">
      <div class="card-body position-relative">
        <% if @category.image.attached? %>
          <%= image_tag url_for(@category.image), class: "float-end ms-3 mb-2", style: "width: 150px;" %>
        <% end %>
        <h2 class="card-title"><%= @category.name %></h2>
        <p class="card-text"><strong>Description:</strong> <%= @category.description %></p>
        <div class="text-end">
          <%= link_to "Edit", edit_category_path(@category), class: "btn btn-outline-secondary me-1" %>
          <%= link_to "Back to List", categories_path, class: "btn btn-outline-secondary", data: { turbo_frame: "_top" } %>
        </div>
      </div>
    </div>
    <div class="text-center mt-4">
      <%= link_to "New Category", new_category_path, class: "btn btn-outline-secondary", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
</div> 