<turbo-stream action="replace" target="category_<%= @category.id %>">
  <template>
    <%= render partial: "categories/category", formats: [:html], locals: { category: @category } %>
  </template>
</turbo-stream>
<turbo-stream action="replace" target="category_form">
  <template>
    <%= render partial: 'form', formats: [:html], locals: { category: Category.new } %>
  </template>
</turbo-stream> 