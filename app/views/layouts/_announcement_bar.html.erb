<div class="announcement-bar" data-controller="announcement">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-md-8">
        <div class="d-flex align-items-center">
          <i class="ti ti-flame me-2"></i>
          <span class="fw-semibold me-3">🔥 Special Sale!</span>
          <span class="d-none d-md-inline">
            Save up to <%= Product.on_sale.maximum('((compare_at_price - price) / compare_at_price * 100)') || 0 %>% 
            on <%= pluralize(Product.on_sale.count, 'product') %>
          </span>
        </div>
      </div>
      <div class="col-md-4 text-md-end">
        <%= link_to products_path(sale: true), class: "btn btn-light btn-sm me-2" do %>
          <i class="ti ti-eye me-1"></i>Shop Sale
        <% end %>
        <button class="btn btn-link text-white p-0" data-action="click->announcement#dismiss">
          <i class="ti ti-x"></i>
        </button>
      </div>
    </div>
  </div>
</div>