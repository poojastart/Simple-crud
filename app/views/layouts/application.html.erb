<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Simple Crud" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lykmapipo/themify-icons@0.1.2/css/themify-icons.css">
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" %>
    
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice.present? %>
      <div class="notice alert alert-success text-center"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-danger text-center"><%= alert %></div>
    <% end %>
    <%= render 'layouts/announcement_bar' %>
    <%= yield %>
    
    <script>
      function initializeAllJS() {
        if (typeof $ === 'undefined') {
          var script = document.createElement('script');
          script.src = 'https://code.jquery.com/jquery-3.6.0.min.js';
          script.onload = function() {
            loadRemainingJS();
          };
          document.head.appendChild(script);
        } else {
          loadRemainingJS();
        }
      }

      function loadRemainingJS() {
        if (typeof window.Popper === 'undefined') {
          var popperScript = document.createElement('script');
          popperScript.src = 'https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js';
          popperScript.onload = function() {
            window.Popper = window.Popper || {};
            loadBootstrap();
          };
          document.head.appendChild(popperScript);
        } else {
          loadBootstrap();
        }
      }

      function loadBootstrap() {
        if (typeof window.bootstrap === 'undefined') {
          var bootstrapScript = document.createElement('script');
          bootstrapScript.src = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js';
          bootstrapScript.onload = function() {
            loadThemeJS();
          };
          document.head.appendChild(bootstrapScript);
        } else {
          loadThemeJS();
        }
      }

      function loadThemeJS() {
        var themeFiles = [
          '<%= asset_path("vendor.bundle.base.js") %>',
          '<%= asset_path("off-canvas.js") %>',
          '<%= asset_path("template.js") %>',
          '<%= asset_path("hoverable-collapse.js") %>'
        ];

        themeFiles.forEach(function(src) {
          if (!document.querySelector('script[src="' + src + '"]')) {
            var script = document.createElement('script');
            script.src = src;
            script.setAttribute('data-turbo-track', 'reload');
            document.head.appendChild(script);
          }
        });

        setTimeout(function() {
          if (typeof initTemplate === 'function') {
            initTemplate();
          }
        }, 200);
      }

      document.addEventListener('DOMContentLoaded', initializeAllJS);
      
      document.addEventListener('turbo:load', function() {
        setTimeout(initializeAllJS, 100);
      });

      document.addEventListener('turbo:render', function() {
        setTimeout(initializeAllJS, 100);
      });
    </script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  </body>
</html>