<tr id="product_<%= product.id %>">
  <td class="fw-light"><%= product.id %></td>
  <td class="fw-light"><%= product.name %></td>
  <td class="fw-light"><%= product&.category&.name || 'None' %></td>
  <td class="fw-light"><%= number_to_currency(product.price) %>
  <% if product.on_sale? %>
        <span class="badge bg-success ms-2">On Sale!</span>
      <% end %>
      </td>
  <td class="fw-light text-center">
    <div class="justify-content-center align-items-center gap-1">
      <%= link_to product_path(product), class: "btn btn-sm btn-outline-info", title: "View" do %>
        <i class="bi bi-eye"></i>
      <% end %>

      <%= link_to edit_product_path(product), class: "btn btn-sm btn-outline-warning", title: "Edit" do %>
        <i class="bi bi-pencil"></i>
      <% end %>

      <%= link_to product_path(product),
            data: { 
              turbo_confirm: "Are you sure you want to delete this product?",
              turbo_method: :delete 
            },
            class: "btn btn-sm btn-outline-danger", 
            title: "Delete" do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
  </td>
</tr>