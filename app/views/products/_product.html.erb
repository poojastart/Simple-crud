<tr id="product_<%= product.id %>">
  <td><%= product.id %></td>
  <td><%= product.name %></td>
  <td><%= number_to_currency(product.price) %></td>
  <td><%= product.description %></td>
  <td class="text-center">
    <%= link_to "Show", product_path(product), class: "btn btn-sm btn-outline-secondary me-1" %>
    <%= link_to "Edit", edit_product_path(product), class: "btn btn-sm btn-outline-secondary me-1" %>
    <%= button_to "Delete", product_path(product), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-secondary" %>
  </td>
</tr>