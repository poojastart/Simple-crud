<% if @products.any? %>
<div class="mb-3">
  <%= link_to "Add Product", new_product_path, class: "btn btn-outline-primary", data: { turbo_frame: "_top" } %>
</div>
  <table class="table table-striped table-borderless">
    <thead class="table-light">
      <tr>
        <th>id</th>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th class="text-center">Actions</th>
      </tr>
    </thead>
    <tbody id="products">
      <%= render @products %>
    </tbody>
  </table>
<% else %>
  <%= render "empty_state" %>
<% end %>