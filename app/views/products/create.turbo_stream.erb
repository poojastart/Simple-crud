<%= turbo_stream.append "products", partial: "products/product", locals: { product: @product } %>
<%= turbo_stream.replace "flash" do %>
  <%= render 'layouts/flash' %>
<% end %>
<%= turbo_stream.replace "new_product" do %>
  <%= render partial: "products/show_product", locals: { product: @product } %>
<% end %>