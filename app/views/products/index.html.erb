<%= turbo_stream_from "products" %>
<div class="products-list-wrapper container mt-5">
<%= turbo_frame_tag @product %>
  <h1 class="mb-4 text-center">Products List</h1>
  <% if @products.any? %>
    
    <%= render partial: "products/products", locals: { products: @products } %>

    <div class="text-end mt-3">
    <%= link_to "New Product", new_product_path, class: "btn btn-outline-secondary" %>
    </div>
  <% else %>
    <div class="alert alert-info text-center mt-4">
      No products found.
    </div>
    <div class="text-center mt-3">
      <%= link_to "New Product", new_product_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>        
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @products %>
  </div>
</div>