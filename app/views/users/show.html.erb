<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body text-center">
          <% if @user.avatar.attached? %>
            <%= image_tag url_for(@user.avatar), class: "rounded-circle mb-3", style: "width: 120px; height: 120px; object-fit: cover;" %>
          <% else %>
            <i class="bi bi-person-circle" style="font-size: 120px; color: #ccc;"></i>
          <% end %>
          <h2 class="mb-2 mt-2"><%= @user.email %></h2>
          <% if @user.role.present? %>
            <span class="badge bg-primary"><%= @user.role.capitalize %></span>
          <% else %>
            <span class="badge bg-secondary">No Role</span>
          <% end %>
          <div class="mt-4">
            <%= link_to "Edit Profile", edit_user_registration_path, class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div> 